{
  "build": {
    "beforeDevCommand": "pnpm run dev:vite",
    "beforeBuildCommand": "pnpm run build:vite",
    "devUrl": "http://localhost:2174",
    "frontendDist": "../dist"
  },
  "identifier": "xyz.yomli.tys",
  "productName": "TYS",
  "version": "0.0.1",
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "TYS",
        "width": 1280,
        "height": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
